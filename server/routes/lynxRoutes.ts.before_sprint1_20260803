import { Router } from 'express';
import { LynxPaymentService } from '../services/lynx/lynxPaymentService.js';
import { LynxWebhookService } from '../services/lynx/lynxWebhookService.js';

export const lynxRouter = Router();

const paymentService = new LynxPaymentService();
const webhookService = new LynxWebhookService();

// POST /api/v1/lynx/order/self-service
lynxRouter.post('/order/self-service', async (req: any, res: any) => {
  try {
    let { buyerId, months, quantity } = req.body;
    const { supabaseAdmin } = await import("../supabaseAdmin.js");
    if (buyerId === 'self_service') {
      const { data: admin } = await supabaseAdmin.from('profiles').select('id').eq('role', 'SUPER_ADMIN').limit(1).single();
      buyerId = admin ? admin.id : buyerId;
    }
    let validity = 30;
    if (months === 12) validity = 365;
    if (months === 24) validity = 730;
    if (months === 36) validity = 1095;
    
    const { data: plan } = await supabaseAdmin.from('license_plans').select('*').eq('validity_days', validity).limit(1).single();
    if (!plan) throw new Error("Plano não encontrado para esta duração");

    // multiply price by quantity
    const total_price = plan.self_service_price * (quantity || 1);
    
    // We modify paymentService to accept custom total price and quantity if needed, or just pass the total price to createOrder
    const order = await paymentService.createOrder(
      buyerId,
      'SELF_SERVICE_LICENSE',
      plan.id, // reference_id
      total_price,
      0, // credits
      `Licença: ${plan.name} x${quantity || 1}`
    );
    res.json({ success: true, order });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

