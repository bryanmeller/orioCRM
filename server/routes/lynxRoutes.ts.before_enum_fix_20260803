// GET /api/v1/lynx/order/:id
lynxRouter.get('/order/:id', async (req: any, res: any) => {
  try {
    const userId = req.user?.id || req.query.userId;
    const order = await paymentService.getOrderStatus(req.params.id, userId);
    res.json({ success: true, order });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
