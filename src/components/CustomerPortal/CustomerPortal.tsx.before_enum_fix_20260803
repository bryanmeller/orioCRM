                    <div className="flex items-center justify-between text-gray-400">
                      <span>Valor Unitário:</span>
                      <strong className="text-white font-mono">R$ {getUnitPriceForMonths(buyPlanMonths).toFixed(2)}</strong>
                    </div>
                    <div className="flex items-center justify-between text-gray-400">
                      <span>Quantidade Selecionada:</span>
                      <strong className="text-white font-mono">{buyQuantity} un.</strong>
                    </div>
                    <div className="flex items-center justify-between text-base font-bold text-white pt-2 border-t border-white/10">
                      <span>Valor Total:</span>
                      <strong className="text-emerald-400 font-mono">
                        R$ {(getUnitPriceForMonths(buyPlanMonths) * buyQuantity).toFixed(2)}
                      </strong>
                    </div>
                  </div>

                  <button
                    type="submit"
                    className="w-full py-4 bg-white hover:bg-gray-200 text-black font-bold text-sm rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
                  >
                    <QrCode size={18} />
                    <span>GERAR PAGAMENTO PIX LYNX</span>
                  </button>
                </form>
              </div>

              <div className="lg:col-span-5 bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-4">
                <h4 className="text-sm font-bold text-white flex items-center gap-2 border-b border-white/10 pb-3">
                  <ShieldCheck size={16} className="text-emerald-400" />
                  <span>Ativação Instantânea Garantida</span>
                </h4>

                <div className="space-y-3 text-xs text-gray-300 leading-relaxed">
                  <p>
                    • Assim que o pagamento via PIX for detectado, suas assinaturas serão ativadas em poucos segundos.
                  </p>
                  <p>
                    • Cada assinatura possui um **Código Alfanumérico exclusivo de 6 caracteres** (ex: <code className="text-emerald-400 font-mono bg-white/5 px-1.5 py-0.5 rounded">A82KQ9</code>).
                  </p>
                  <p>
                    • Os códigos gerados aparecem imediatamente no menu **Minhas Assinaturas** para acesso instantâneo.
                  </p>
                </div>
              </div>
            </div>
          ) : (
            /* Active Lynx PIX Order Screen */
            <div className="max-w-2xl mx-auto bg-[#000000] border border-emerald-500/30 rounded-xl p-8 shadow-2xl space-y-6 animate-in fade-in zoom-in duration-200">
              <div className="text-center space-y-1 border-b border-white/10 pb-4">
                <span className="bg-amber-500/20 text-amber-400 text-xs font-bold px-3 py-1 rounded-full border border-amber-500/30 uppercase">
                  AGUARDANDO PAGAMENTO PIX
                </span>
                <h3 className="text-2xl font-bold text-white tracking-tight">Pedido #{activePixOrder.orderNumber}</h3>
                <p className="text-xs text-gray-400">Total: R$ {activePixOrder.totalPrice.toFixed(2)} ({activePixOrder.quantity} assinatura(s) de {activePixOrder.months} meses)</p>
              </div>

              <div className="flex flex-col items-center justify-center space-y-3">
                <div className="w-48 h-48 bg-white p-3 rounded-xl flex items-center justify-center shadow-lg">
                  <QrCode size={160} className="text-black" />
                </div>
                <span className="text-xs text-gray-400 font-mono">Abra o app do seu banco e escaneie o QR Code</span>
              </div>

              <div className="space-y-2">
                <label className="text-xs font-bold text-gray-300 block">Código Pix Copia e Cola:</label>
                <div className="flex items-center gap-2">
                  <input
                    type="text"
                    readOnly
                    value={activePixOrder.pixCopyPaste}
                    className="flex-1 bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs font-mono text-emerald-400 truncate"
                  />
                  <button
                    onClick={() => {
                      navigator.clipboard.writeText(activePixOrder.pixCopyPaste);
                      setCopiedPix(true);
                      setTimeout(() => setCopiedPix(false), 2000);
                      showToast('Código PIX copiado para a área de transferência!');
                    }}
                    className="px-4 py-3 bg-[#6A00FF] hover:bg-[#801aff] text-white text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center gap-1.5 shrink-0"
                  >
                    {copiedPix ? <Check size={16} /> : <Copy size={16} />}
                    <span>{copiedPix ? 'Copiado!' : 'Copiar'}</span>
                  </button>
                </div>
              </div>

              <div className="pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
                <button
                  onClick={() => setActivePixOrder(null)}
                  className="text-xs text-gray-400 hover:text-white underline cursor-pointer"
                >
                  Cancelar Pedido
                </button>

                <button
                  onClick={handleSimulateLynxPixPayment}
                  disabled={isProcessingPix}
                  className="px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer disabled:opacity-50"
                >
                  {isProcessingPix ? (
                    <RefreshCw size={16} className="animate-spin" />
                  ) : (
                    <CheckCircle2 size={16} />
                  )}
                  <span>{isProcessingPix ? 'Processando Webhook...' : 'Simular Confirmação Webhook Lynx PIX'}</span>
                </button>
              </div>
            </div>
          )}
        </div>
      )}

      {/* TAB 3: RENOVAR OU ATIVAR ASSINATURA */}
      {activeTab === 'renew-license' && (
        <div className="space-y-6">
          <div className="bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-2">
            <div className="inline-flex items-center gap-2 bg-[#6A00FF]/20 border border-white/10 px-3 py-1 rounded-full text-xs font-bold text-gray-300">
              <RefreshCw size={14} />
              <span>{licenses.find(l => l.id === selectedLicenseToRenew)?.status === 'TRIAL' ? 'ATIVAÇÃO DE TESTE GRATUITO' : 'RENOVAÇÃO DE ASSINATURA'}</span>
            </div>
            <h3 className="text-xl font-bold text-white tracking-tight">
              {licenses.find(l => l.id === selectedLicenseToRenew)?.status === 'TRIAL'
                ? 'Ativar Assinatura em Teste Gratuito'
                : 'Estender Validade da Assinatura'}
            </h3>
            <p className="text-xs text-gray-400">
              {licenses.find(l => l.id === selectedLicenseToRenew)?.status === 'TRIAL'
                ? 'Transforme seu teste gratuito em uma licença ativa oficial mantendo o mesmo código de acesso.'
                : 'Selecione a assinatura que deseja renovar por mais 12, 24 ou 36 meses.'}
            </p>
          </div>

          <div className="max-w-xl mx-auto bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-5">
            <form onSubmit={handleRenewLicenseSubmit} className="space-y-4">
              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Selecione a Assinatura:</label>
                <select
                  value={selectedLicenseToRenew}
                  onChange={(e) => setSelectedLicenseToRenew(e.target.value)}
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30 font-mono"
                >
                  {licenses.map((lic) => (
                    <option key={lic.id} value={lic.id}>
                      Código: {lic.code6Char} ({lic.status === 'TRIAL' ? 'TESTE GRATUITO' : lic.status}) - Validade: {lic.expiresAt}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Selecione o Período:</label>
                <div className="grid grid-cols-3 gap-3">
                  {[12, 24, 36].map((m) => (
                    <button
                      key={m}
                      type="button"
                      onClick={() => setRenewMonths(m)}
                      className={`p-3 rounded-xl border text-center transition-all cursor-pointer ${
                        renewMonths === m
                          ? 'bg-[#6A00FF]/20 border-[#6A00FF] text-white shadow-sm'
                          : 'bg-[#000000] border-white/10 text-gray-400 hover:text-white'
                      }`}
                    >
                      <span className="text-sm font-bold block">+{m} Meses</span>
                      <span className="text-xs text-emerald-400 font-bold block mt-1">
                        R$ {getUnitPriceForMonths(m).toFixed(2)}
                      </span>
                    </button>
                  ))}
                </div>
              </div>

              <button
                type="submit"
                className="w-full py-4 bg-white hover:bg-gray-200 text-black font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
              >
                <Sparkles size={16} />
                <span>
                  {licenses.find((l) => l.id === selectedLicenseToRenew)?.status === 'TRIAL'
                    ? 'CONFIRMAR ATIVAÇÃO DA LICENÇA'
                    : 'CONFIRMAR RENOVAÇÃO DA ASSINATURA'}
                </span>
              </button>
            </form>
          </div>
        </div>
      )}

      {/* TAB 4: DISPOSITIVOS CONECTADOS */}
      {activeTab === 'devices' && (
        <div className="space-y-6">
          <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <h3 className="text-lg font-bold text-white flex items-center gap-2">
                <Smartphone size={18} className="text-gray-300" />
                <span>Dispositivos Conectados</span>
              </h3>
              <p className="text-xs text-gray-400">Aparelhos e Smart TVs vinculados às suas assinaturas</p>
            </div>

            <span className="text-xs text-gray-400 font-mono bg-white/5 px-3 py-1 rounded-lg border border-white/10">
              Identificação via Device ID & MAC
            </span>
          </div>

          {devices.length === 0 ? (
            <div className="bg-[#000000] border border-white/10 rounded-xl p-8 text-center space-y-3">
              <Smartphone size={36} className="text-gray-500 mx-auto" />
              <h4 className="text-sm font-bold text-white">Nenhum dispositivo conectado</h4>
              <p className="text-xs text-gray-400">
                Ao entrar no aplicativo StreamFlix TV na sua Smart TV ou celular, o dispositivo aparecerá listado aqui automaticamente.
              </p>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {devices.map((dev) => (
                <div
                  key={dev.id}
                  className="bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-4 relative overflow-hidden"
                >
                  <div className="flex items-start justify-between">
                    <div>
                      <h4 className="text-base font-bold text-white">{dev.deviceName}</h4>
                      <span className="text-xs text-gray-400 font-mono">Último Acesso: {dev.lastAccess}</span>
                    </div>

                    <span
                      className={`px-2.5 py-0.5 rounded-full text-xs font-bold border ${
                        dev.status === 'Ativo'
                          ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'
                          : 'bg-amber-500/20 text-amber-400 border-amber-500/30'
                      }`}
                    >
                      {dev.status}
                    </span>
                  </div>

                  <div className="space-y-2 pt-2 border-t border-white/5 text-xs font-mono">
                    <div className="flex items-center justify-between text-gray-300">
                      <span className="text-gray-500 font-sans">Identificador (Device ID):</span>
                      <strong className="text-white bg-white/5 px-2 py-0.5 rounded">{dev.deviceId}</strong>
                    </div>

                    {dev.macAddress && (
                      <div className="flex items-center justify-between text-gray-300">
                        <span className="text-gray-500 font-sans">Endereço MAC:</span>
                        <strong className="text-emerald-400 bg-white/5 px-2 py-0.5 rounded">{dev.macAddress}</strong>
                      </div>
                    )}

                    <div className="flex items-center justify-between text-gray-300">
                      <span className="text-gray-500 font-sans">Assinatura Vinculada:</span>
                      <strong className="text-gray-300 font-bold">{dev.linkedLicenseCode}</strong>
                    </div>
                  </div>

                  <div className="pt-2 flex items-center justify-end gap-2">
                    <button
                      onClick={() => handleDeactivateLicense(dev.linkedLicenseCode)}
                      className="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 text-xs font-bold rounded-lg border border-amber-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
                    >
                      <Power size={13} />
                      <span>Desativar</span>
                    </button>

                    <button
                      onClick={() => handleRemoveDevice(dev.id)}
                      className="px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 text-xs font-bold rounded-lg border border-red-500/30 transition-all flex items-center gap-1.5 cursor-pointer"
                    >
                      <Trash2 size={13} />
                      <span>Remover</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {/* TAB 5: HISTÓRICO DE COMPRAS */}
      {activeTab === 'history' && (
        <div className="space-y-6">
          <h3 className="text-lg font-bold text-white flex items-center gap-2">
            <History size={18} className="text-gray-300" />
            <span>Histórico de Compras e Transações</span>
          </h3>

          <div className="bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md overflow-x-auto">
            {purchases.length === 0 ? (
              <p className="text-xs text-gray-400 text-center py-4">Nenhuma transação registrada até o momento.</p>
            ) : (
              <table className="w-full text-left text-xs">
                <thead>
                  <tr className="border-b border-white/10 text-gray-400 font-bold uppercase text-[11px] tracking-wider">
                    <th className="py-3 px-4">Pedido</th>
                    <th className="py-3 px-4">Data/Hora</th>
                    <th className="py-3 px-4">Plano Contratado</th>
                    <th className="py-3 px-4">Qtd.</th>
                    <th className="py-3 px-4">Valor Total</th>
                    <th className="py-3 px-4">Código Ativado</th>
                    <th className="py-3 px-4">Status</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-white/5">
                  {purchases.map((p) => (
                    <tr key={p.id} className="hover:bg-white/[0.02] transition-colors">
                      <td className="py-3 px-4 font-bold text-white">{p.orderNumber}</td>
                      <td className="py-3 px-4 text-gray-300 font-mono">{p.date}</td>
                      <td className="py-3 px-4 text-white font-bold">{p.planName}</td>
                      <td className="py-3 px-4 font-mono font-bold text-white">{p.quantity} un.</td>
                      <td className="py-3 px-4 font-mono font-bold text-emerald-400">R$ {p.totalPrice.toFixed(2)}</td>
                      <td className="py-3 px-4 font-mono font-bold text-gray-300">
                        {p.generatedCodes.join(', ') || '-'}
                      </td>
                      <td className="py-3 px-4">
                        <span
                          className={`px-2 py-0.5 rounded text-xs font-bold border uppercase ${
                            p.status === 'PAGO'
                              ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/20'
                              : 'bg-amber-500/20 text-amber-400 border-amber-500/20'
                          }`}
                        >
                          {p.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </div>
      )}

      {/* TAB 6: MINHA CONTA */}
      {activeTab === 'account' && (
        <div className="space-y-6">
          <h3 className="text-lg font-bold text-white flex items-center gap-2">
            <User size={18} className="text-gray-300" />
            <span>Dados da Minha Conta</span>
          </h3>

          <div className="max-w-xl mx-auto bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-4">
            <div className="space-y-3 text-xs">
              <div className="flex justify-between py-2 border-b border-white/5">
                <span className="text-gray-400">Nome Completo:</span>
                <strong className="text-white">{customerUser.name}</strong>
              </div>
              <div className="flex justify-between py-2 border-b border-white/5">
                <span className="text-gray-400">E-mail:</span>
                <strong className="text-white">{customerUser.email}</strong>
              </div>
              <div className="flex justify-between py-2 border-b border-white/5">
                <span className="text-gray-400">Telefone:</span>
                <strong className="text-white">{customerUser.phone}</strong>
              </div>
              <div className="flex justify-between py-2 border-b border-white/5">
                <span className="text-gray-400">Origem do Cadastro:</span>
                <strong className="text-emerald-400">{getFriendlyOrigin(customerUser.origin, customerUser.originName)}</strong>
              </div>
              <div className="flex justify-between py-2 border-b border-white/5">
                <span className="text-gray-400">Provedor / Sistema:</span>
                <strong className="text-white">{customerUser.originName}</strong>
              </div>
              <div className="flex justify-between py-2">
                <span className="text-gray-400">Data de Cadastro:</span>
                <strong className="text-white font-mono">{customerUser.createdAt}</strong>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* TAB 7: ALTERAR SENHA */}
      {activeTab === 'change-password' && (
        <div className="space-y-6">
          <h3 className="text-lg font-bold text-white flex items-center gap-2">
            <Lock size={18} className="text-gray-300" />
            <span>Alteração de Senha</span>
          </h3>

          <div className="max-w-md mx-auto bg-[#000000] border border-white/10 rounded-xl p-6 shadow-md space-y-4">
            <form onSubmit={handleChangePasswordSubmit} className="space-y-4">
              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Senha Atual *</label>
                <input
                  type="password"
                  value={currentPassword}
                  onChange={(e) => setCurrentPassword(e.target.value)}
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Nova Senha *</label>
                <input
                  type="password"
                  value={newPassword}
                  onChange={(e) => setNewPassword(e.target.value)}
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Confirmar Nova Senha *</label>
                <input
                  type="password"
                  value={confirmPassword}
                  onChange={(e) => setConfirmPassword(e.target.value)}
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <button
                type="submit"
                className="w-full py-3.5 bg-white hover:bg-gray-200 text-black font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
              >
                <span>SALVAR NOVA SENHA</span>
              </button>
            </form>
          </div>
        </div>
      )}

      {/* DNS MODAL FOR ADDING SERVER */}
      {showDnsModal && selectedLicForDns && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#000000] border border-white/10 rounded-xl p-6 max-w-md w-full space-y-4 relative shadow-2xl">
            <div className="flex items-center justify-between border-b border-white/10 pb-3">
              <h4 className="text-sm font-bold text-white flex items-center gap-2">
                <Globe size={16} className="text-emerald-400" />
                <span>Adicionar Servidor (DNS)</span>
              </h4>
              <button
                onClick={() => {
                  setShowDnsModal(false);
                  setSelectedLicForDns(null);
                  setNewDnsInput('');
                }}
                className="text-gray-400 hover:text-white text-xs font-bold cursor-pointer"
              >
                ✕
              </button>
            </div>

            <p className="text-xs text-gray-300">
              Insira o endereço do servidor DNS para a assinatura <code className="text-emerald-400 font-mono font-bold">{selectedLicForDns.code6Char}</code>:
            </p>

            <div>
              <label className="text-xs font-bold text-gray-300 block mb-1">URL / Endereço do Servidor:</label>
              <input
                type="text"
                value={newDnsInput}
                onChange={(e) => setNewDnsInput(e.target.value)}
                placeholder="ex: http://cdn.meuservidor.com:8080"
                className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-2.5 text-xs text-white font-mono focus:outline-none focus:border-white/30"
              />
            </div>

            <div className="flex items-center justify-end gap-2 pt-2">
              <button
                type="button"
                onClick={() => {
                  setShowDnsModal(false);
                  setSelectedLicForDns(null);
                  setNewDnsInput('');
                }}
                className="px-4 py-2 bg-white/5 hover:bg-white/10 text-xs font-bold rounded-lg border border-white/10 text-gray-300 transition-all cursor-pointer"
              >
                Cancelar
              </button>

              <button
                type="button"
                onClick={handleAddDnsSubmit}
                className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-black text-xs font-bold rounded-lg transition-all cursor-pointer"
              >
                Salvar Servidor
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
