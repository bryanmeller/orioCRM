// Helper: Calculate remaining days from date string (DD/MM/YYYY or YYYY-MM-DD or ISO)
const calculateDaysRemaining = (expiresAtStr: string): number => {
  if (!expiresAtStr) return 0;

  let targetDate: Date | null = null;

  if (expiresAtStr.includes('/')) {
    const parts = expiresAtStr.split('/');
    if (parts.length === 3) {
      targetDate = new Date(Number(parts[2]), Number(parts[1]) - 1, Number(parts[0]));
    }
  } else {
    const parsed = new Date(expiresAtStr);
    if (!isNaN(parsed.getTime())) {
      targetDate = parsed;
    }
  }

  if (!targetDate || isNaN(targetDate.getTime())) return 0;

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  targetDate.setHours(0, 0, 0, 0);

  const diffTime = targetDate.getTime() - today.getTime();
  return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
};

// Helper: Friendly Origin Label
const getFriendlyOrigin = (origin?: string, originName?: string): string => {
  if (!origin) return originName && originName !== 'Sistema' ? `Criada por ${originName}` : 'Criada pelo Sistema';

  const norm = origin.toUpperCase();
  if (norm.includes('SUPER_ADMIN') || norm.includes('SYSTEM') || norm.includes('SISTEMA')) {
    return 'Criada pelo Sistema';
  }
  if (norm.includes('PROVIDER') || norm.includes('PROVEDOR')) {
    return originName && originName !== 'Sistema' ? `Criada pelo Provedor (${originName})` : 'Criada pelo Provedor';
  }
  if (norm.includes('SUB_RESELLER') || norm.includes('SUB_REVENDA')) {
    return originName ? `Criada pela Sub-Revenda (${originName})` : 'Criada pela Sub-Revenda';
  }
  if (norm.includes('RESELLER') || norm.includes('REVENDA')) {
    return originName ? `Criada pela Revenda (${originName})` : 'Criada pela Revenda';
  }
  if (norm.includes('SELF_SERVICE') || norm.includes('PORTAL')) {
    return 'Ativada no Portal';
  }
  return originName ? `Criada por ${originName}` : `Criada via ${origin}`;
};

// Helper: Days remaining badge styling
const getDaysRemainingBadgeStyle = (days: number): string => {
  if (days <= 0) {
    return 'bg-red-500/20 text-red-400 border border-red-500/40';
  }
  if (days === 1) {
    return 'bg-red-500/25 text-red-300 border border-red-500/50 font-extrabold shadow-sm shadow-red-900/50';
  }
  if (days <= 3) {
    return 'bg-orange-500/20 text-orange-400 border border-orange-500/40 font-bold';
  }
  if (days <= 7) {
    return 'bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold';
  }
  return 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
};

