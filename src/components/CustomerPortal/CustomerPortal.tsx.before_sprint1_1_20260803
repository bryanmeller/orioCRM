import React, { useState, useEffect } from 'react';
import {
  User,
  Key,
  ShoppingCart,
  RefreshCw,
  Smartphone,
  History,
  Lock,
  LogOut,
  Sparkles,
  QrCode,
  Copy,
  Check,
  CheckCircle2,
  AlertCircle,
  Clock,
  ShieldCheck,
  Globe,
  Plus,
  Trash2,
  Power,
  ChevronRight,
  Tv,
  ArrowRight,
  Search,
  ExternalLink,
  CreditCard,
  Building2,
  Coins
} from 'lucide-react';

// End-User License Interface (MÓDULO 18)
export interface EndUserLicense {
  id: string;
  uuid: string;
  code6Char: string; // e.g. A82KQ9
  planName: string;
  durationMonths: number;
  status: 'TRIAL' | 'ACTIVE' | 'EXPIRED' | 'BLOCKED' | 'CANCELLED';
  expiresAt: string;
  createdAt: string;
  deviceId?: string;
  deviceMac?: string;
  linkedDns: string;
  origin: 'SUPER_ADMIN' | 'PROVIDER' | 'RESELLER' | 'SUB_RESELLER' | 'SELF_SERVICE';
  originName: string;
}

// Device Record Interface (MÓDULO 18)
export interface UserDeviceItem {
  id: string;
  deviceName: string;
  deviceId: string;
  macAddress?: string;
  lastAccess: string;
  status: 'Ativo' | 'Inativo' | 'Bloqueado';
  linkedLicenseCode: string;
}

// Purchase Record Interface (MÓDULO 18)
export interface PurchaseRecord {
  id: string;
  orderNumber: string;
  date: string;
  planName: string;
  months: number;
  quantity: number;
  unitPrice: number;
  totalPrice: number;
  status: 'PAGO' | 'AGUARDANDO_PIX' | 'CANCELADO';
  pixCopyPaste: string;
  generatedCodes: string[];
}

export const CustomerPortal: React.FC = () => {
  // Authentication State for Customer Portal
  const [isAuthenticated, setIsAuthenticated] = useState<boolean>(false);
  const [token, setToken] = useState<string>('');
  const [authMode, setAuthMode] = useState<'LOGIN' | 'REGISTER'>('LOGIN');

  // Login Form
  const [loginEmail, setLoginEmail] = useState<string>('');
  const [loginPassword, setLoginPassword] = useState<string>('');

  // Register Form
  const [regName, setRegName] = useState<string>('');
  const [regEmail, setRegEmail] = useState<string>('');
  const [regPhone, setRegPhone] = useState<string>('');
  const [regPassword, setRegPassword] = useState<string>('');

  // Active Menu Tab
  const [activeTab, setActiveTab] = useState<
    | 'account'
    | 'licenses'
    | 'buy-license'
    | 'renew-license'
    | 'devices'
    | 'history'
    | 'change-password'
  >('licenses');

  // Customer Profile Info
  const [customerUser, setCustomerUser] = useState({
    id: 'cli-8842',
    name: 'Carlos Silva',
    email: 'carlos.silva@email.com',
    phone: '(11) 98765-4321',
    origin: 'PROVEDOR' as 'PROVEDOR' | 'REVENDA',
    originName: 'StreamFlix Media Group',
    code: '100', // Nomenclature standardized to 'Código'
    createdAt: '15/01/2026',
  });

  // Toast Notification State
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  useEffect(() => {
    if (isAuthenticated && token) {
        fetch('/api/portal/me', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
            if (data.user) {
                setCustomerUser({
                     id: data.user.id,
                     name: data.user.name || data.user.username,
                     email: data.user.email || '',
                     phone: data.user.phone || '',
                     origin: data.user.originType || data.user.origin || 'SELF_SERVICE',
                     originName: data.user.providerName || 'Sistema',
                     code: data.user.code || data.user.licenseCode || '',
                     createdAt: data.user.createdAt || data.user.created_at || new Date().toISOString(),
                });
            }
            if (data.licenses) setLicenses(data.licenses);
            if (data.devices) setDevices(data.devices);
            if (data.purchases) setPurchases(data.purchases);
        })
        .catch(err => {
            // Tratamento silencioso da exceção
        });
    }
  }, [isAuthenticated, token]);

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3500);
  };

  const [licenses, setLicenses] = useState<EndUserLicense[]>([]);

  // Devices State
  const [devices, setDevices] = useState<any[]>([]);

  // Purchases History State
  const [purchases, setPurchases] = useState<any[]>([]);

  // Purchase Form State
  const [buyPlanMonths, setBuyPlanMonths] = useState<number>(12);
  const [buyQuantity, setBuyQuantity] = useState<number>(1);
  const [activePixOrder, setActivePixOrder] = useState<PurchaseRecord | null>(null);
  const [isProcessingPix, setIsProcessingPix] = useState<boolean>(false);
  const [copiedPix, setCopiedPix] = useState<boolean>(false);

  // License Renewal State
  const [selectedLicenseToRenew, setSelectedLicenseToRenew] = useState<string>(licenses[0]?.id || '');
  const [renewMonths, setRenewMonths] = useState<number>(12);

  // Change Password Form State
  const [currentPassword, setCurrentPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');

  // 6-Character Unique Alphanumeric Generator
  const generate6CharAlphanumericCode = (): string => {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let code = '';
    for (let i = 0; i < 6; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return code;
  };

  // Helper calculation for prices
  const getUnitPriceForMonths = (months: number): number => {
    if (months === 12) return 199.00;
    if (months === 24) return 349.00;
    if (months === 36) return 489.00;
    return 199.00;
  };

  // Login Handler
  const handleLoginSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!loginEmail.trim() || !loginPassword.trim()) {
      showToast('Por favor, preencha todos os campos para entrar.');
      return;
    }
    try {
       const res = await fetch('/api/auth/portal/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: loginEmail.trim(), password: loginPassword })
       });
       const data = await res.json();
       if (!res.ok) {
           showToast(data.error || 'Erro no login.');
           return;
       }
       
       // user is stored in data.user
       const user = data.user;
       setCustomerUser({
         id: user.id || 'cli-new',
         name: user.name || 'Cliente',
         email: user.email || '',
         phone: user.phone || '',
         origin: user.originType || user.origin || 'SELF_SERVICE',
         originName: user.providerName || 'Sistema',
         code: user.code || user.licenseCode || '',
         createdAt: user.createdAt || new Date().toISOString(),
       });
       
       setToken(data.token);
       setIsAuthenticated(true);
       showToast(`Bem-vindo de volta!`);
    } catch (err: any) {
       showToast(err.message || 'Erro na conexão.');
    }
  };

  // Register Handler
  const handleRegisterSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!regName.trim() || !regEmail.trim() || !regPassword.trim()) {
      showToast('Por favor, preencha os campos obrigatórios (Nome, E-mail e Senha).');
      return;
    }

    setCustomerUser({
      id: `cli-${Date.now().toString().slice(-4)}`,
      name: regName.trim(),
      email: regEmail.trim(),
      phone: regPhone.trim() || '(Não informado)',
      origin: 'PROVEDOR',
      originName: 'StreamFlix Media Group',
      code: '100',
      createdAt: new Date().toLocaleDateString('pt-BR'),
    });

    setIsAuthenticated(true);
    showToast('Conta criada com sucesso! Você já está autenticado.');
  };

  // Handle New License Purchase Creation -> Lynx PIX
  const handleCreatePurchase = async (e: React.FormEvent) => {
    e.preventDefault();
    showToast("Pagamento temporariamente indisponível. Integração com o Gateway em configuração.");
  };

  // Handle Simulate Lynx PIX Webhook Payment Callback
  const handleSimulateLynxPixPayment = () => {
    if (!activePixOrder) return;
    setIsProcessingPix(true);

    setTimeout(() => {
      // Auto Generate Purchased Licenses upon payment
      const newGeneratedCodes: string[] = [];
      const newCreatedLicenses: EndUserLicense[] = [];

      for (let i = 0; i < activePixOrder.quantity; i++) {
        const code6 = generate6CharAlphanumericCode();
        newGeneratedCodes.push(code6);

        const expDate = new Date();
        expDate.setMonth(expDate.getMonth() + activePixOrder.months);

        const newLic: EndUserLicense = {
          id: `lic-${Date.now() + i}`,
          uuid: crypto.randomUUID(),
          code6Char: code6,
          planName: activePixOrder.planName,
          durationMonths: activePixOrder.months,
          status: 'ACTIVE',
          expiresAt: expDate.toLocaleDateString('pt-BR'),
          createdAt: new Date().toLocaleDateString('pt-BR'),
          linkedDns: 'https://cdn.streamflix-provider.com',
          origin: customerUser.origin,
          originName: customerUser.originName,
        };

        newCreatedLicenses.push(newLic);
      }

      // Update Purchases record
      setPurchases((prev) =>
        prev.map((p) =>
          p.id === activePixOrder.id
            ? { ...p, status: 'PAGO', generatedCodes: newGeneratedCodes }
            : p
        )
      );

      // Add newly generated licenses
      setLicenses((prev) => [...newCreatedLicenses, ...prev]);

      setIsProcessingPix(false);
      setActivePixOrder(null);
      setActiveTab('licenses');
      showToast(`Pagamento PIX confirmado via Webhook Lynx! ${activePixOrder.quantity} licença(s) gerada(s) automaticamente.`);
    }, 2000);
  };

  // Handle License Renewal via Lynx PIX
  const handleRenewLicenseSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const targetLic = licenses.find((l) => l.id === selectedLicenseToRenew);
    if (!targetLic) {
      showToast('Selecione uma licença válida para renovar.');
      return;
    }

    const price = getUnitPriceForMonths(renewMonths);

    // Update license expiration
    setLicenses((prev) =>
      prev.map((lic) => {
        if (lic.id === targetLic.id) {
          const expParts = lic.expiresAt.split('/');
          let currDate = new Date();

          if (expParts.length === 3) {
            const parsed = new Date(Number(expParts[2]), Number(expParts[1]) - 1, Number(expParts[0]));
            if (parsed > new Date()) {
              currDate = parsed;
            }
          }

          currDate.setMonth(currDate.getMonth() + renewMonths);

          return {
            ...lic,
            durationMonths: lic.durationMonths + renewMonths,
            status: 'ACTIVE',
            expiresAt: currDate.toLocaleDateString('pt-BR'),
          };
        }
        return lic;
      })
    );

    // Add to purchase history
    const renewalRecord: PurchaseRecord = {
      id: `ord-${Date.now().toString().slice(-4)}`,
      orderNumber: `RENEW-${targetLic.code6Char}-${Math.floor(100 + Math.random() * 900)}`,
      date: new Date().toLocaleString('pt-BR'),
      planName: `Renovação de Licença (${renewMonths} Meses) - ${targetLic.code6Char}`,
      months: renewMonths,
      quantity: 1,
      unitPrice: price,
      totalPrice: price,
      status: 'PAGO',
      pixCopyPaste: '00020126580014BR.GOV.BCB.PIX0136stf-renew-pix-key',
      generatedCodes: [targetLic.code6Char],
    };

    setPurchases([renewalRecord, ...purchases]);
    showToast(`Licença ${targetLic.code6Char} renovada com sucesso por +${renewMonths} meses!`);
  };

  // Handle Device Actions
  const handleRemoveDevice = async (devId: string) => {
    try {
        const res = await fetch('/api/portal/remove-device', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
            body: JSON.stringify({ deviceId: devId })
        });
        if (!res.ok) throw new Error('Erro ao remover dispositivo.');
        setDevices((prev) => prev.filter((d) => d.id !== devId));
        showToast('Dispositivo removido da conta com sucesso!');
    } catch (err: any) {
        showToast(err.message);
    }
  };

  const handleDeactivateLicense = (licCode: string) => {
    setLicenses((prev) =>
      prev.map((l) =>
        l.code6Char === licCode ? { ...l, status: 'BLOCKED', deviceId: undefined, deviceMac: undefined } : l
      )
    );
    setDevices((prev) =>
      prev.map((d) => (d.linkedLicenseCode === licCode ? { ...d, status: 'Inativo' } : d))
    );
    showToast(`Licença ${licCode} desativada do dispositivo. Pronta para futura vinculação.`);
  };

  // Handle Change Password
  const handleChangePasswordSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (newPassword.length < 6) {
      showToast('A nova senha deve ter no mínimo 6 caracteres.');
      return;
    }
    if (newPassword !== confirmPassword) {
      showToast('A nova senha e a confirmação não coincidem.');
      return;
    }

    try {
      const res = await fetch('/api/portal/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ newPassword })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Erro ao alterar senha.');

      setCurrentPassword('');
      setNewPassword('');
      setConfirmPassword('');
      showToast('Sua senha foi alterada com sucesso!');
    } catch (err: any) {
      showToast(err.message || 'Erro ao alterar senha.');
    }
  };

  // If user is not authenticated on Customer Portal
  if (!isAuthenticated) {
    return (
      <div className="w-full min-h-[calc(100vh-120px)] bg-[#000000] flex items-center justify-center p-6 font-sans">
        {/* Toast Notification */}
        {toastMessage && (
          <div className="fixed top-20 right-6 z-50 bg-[#6A00FF] text-white px-5 py-3 rounded-lg shadow-sm border border-white/10 flex items-center gap-2 text-xs font-bold animate-in fade-in slide-in-from-top-4 duration-200">
            <Sparkles size={16} />
            <span>{toastMessage}</span>
          </div>
        )}

        <div className="max-w-md w-full bg-[#000000] border border-white/10 rounded-lg p-8 shadow-sm space-y-6 relative overflow-hidden">
          {/* Top Brand Banner */}
          <div className="text-center space-y-2">
            <div className="w-16 h-16 bg-white text-black rounded-lg flex items-center justify-center mx-auto shadow-sm shadow-[#6A00FF]/40 border border-white/10">
              <Tv size={32} className="text-white" />
            </div>
            <h2 className="text-2xl font-semibold text-white tracking-tight">PORTAL DO CLIENTE</h2>
            <p className="text-xs text-gray-400">Adquira e gerencie suas licenças e dispositivos StreamFlix TV</p>
          </div>

          {/* Toggle Login vs Register */}
          <div className="flex bg-[#000000] p-1 rounded-lg border border-white/10 text-xs font-bold">
            <button
              onClick={() => setAuthMode('LOGIN')}
              className={`flex-1 py-2.5 rounded-lg transition-all cursor-pointer ${
                authMode === 'LOGIN'
                  ? 'bg-white text-black shadow-sm'
                  : 'text-gray-400 hover:text-white'
              }`}
            >
              Já tenho Conta (Entrar)
            </button>
            <button
              onClick={() => setAuthMode('REGISTER')}
              className={`flex-1 py-2.5 rounded-lg transition-all cursor-pointer ${
                authMode === 'REGISTER'
                  ? 'bg-white text-black shadow-sm'
                  : 'text-gray-400 hover:text-white'
              }`}
            >
              Criar Nova Conta
            </button>
          </div>

          {/* Login Form */}
          {authMode === 'LOGIN' && (
            <form onSubmit={handleLoginSubmit} className="space-y-4">
              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">E-mail Cadastrado</label>
                <input
                  type="email"
                  value={loginEmail}
                  onChange={(e) => setLoginEmail(e.target.value)}
                  placeholder="seu@email.com"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Senha de Acesso</label>
                <input
                  type="password"
                  value={loginPassword}
                  onChange={(e) => setLoginPassword(e.target.value)}
                  placeholder="••••••••"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <button
                type="submit"
                className="w-full py-3.5 bg-white hover:bg-gray-200 text-black font-medium text-xs rounded-lg shadow-sm shadow-[#6A00FF]/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>ACESSAR PORTAL DO CLIENTE</span>
                <ArrowRight size={16} />
              </button>
            </form>
          )}

          {/* Register Form */}
          {authMode === 'REGISTER' && (
            <form onSubmit={handleRegisterSubmit} className="space-y-4">
              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Nome Completo *</label>
                <input
                  type="text"
                  value={regName}
                  onChange={(e) => setRegName(e.target.value)}
                  placeholder="Ex: Carlos Silva"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">E-mail *</label>
                <input
                  type="email"
                  value={regEmail}
                  onChange={(e) => setRegEmail(e.target.value)}
                  placeholder="carlos.silva@email.com"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Telefone WhatsApp (Opcional)</label>
                <input
                  type="tel"
                  value={regPhone}
                  onChange={(e) => setRegPhone(e.target.value)}
                  placeholder="(11) 98765-4321"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                />
              </div>

              <div>
                <label className="text-xs font-bold text-gray-300 block mb-1">Senha de Acesso *</label>
                <input
                  type="password"
                  value={regPassword}
                  onChange={(e) => setRegPassword(e.target.value)}
                  placeholder="No mínimo 6 caracteres"
                  className="w-full bg-[#000000] border border-white/10 rounded-lg px-4 py-3 text-xs text-white focus:outline-none focus:border-white/30"
                  required
                />
              </div>

              <button
                type="submit"
                className="w-full py-3.5 bg-white hover:bg-gray-200 text-black font-medium text-xs rounded-lg shadow-sm shadow-[#6A00FF]/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <Sparkles size={16} />
                <span>CADASTRAR E CONTINUAR</span>
              </button>
            </form>
          )}
        </div>
      </div>
    );
  }

  // Authenticated Main View
  return (
    <div className="w-full max-w-7xl mx-auto p-4 space-y-6 font-sans">
      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed top-20 right-6 z-50 bg-[#6A00FF] text-white px-5 py-3 rounded-lg shadow-sm border border-white/10 flex items-center gap-2 text-xs font-bold animate-in fade-in slide-in-from-top-4 duration-200">
          <Sparkles size={16} />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* Top Welcome Bar */}
      <div className="bg-[#000000] border border-white/10 rounded-lg p-6 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div className="flex items-center gap-4">
          <div className="w-14 h-14 rounded-lg bg-white text-black flex items-center justify-center font-semibold text-white text-xl shadow-sm border border-white/10">
            {customerUser.name.charAt(0)}
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-xl font-semibold text-white tracking-tight">{customerUser.name}</h2>
              <span className="bg-emerald-500/20 text-emerald-400 px-2.5 py-0.5 rounded-full text-xs font-bold border border-emerald-500/30">
                CLIENTE ATIVO
              </span>
            </div>
            <p className="text-xs text-gray-400">{customerUser.email} • {customerUser.phone}</p>
          </div>
        </div>

        <div className="flex items-center gap-3">
          <div className="bg-[#000000] px-3.5 py-2 rounded-lg border border-white/10 text-xs text-gray-300">
            <span className="text-xs text-gray-500 font-bold block uppercase">Origem Vinculada:</span>
            <strong className="text-white">{customerUser.originName}</strong>
          </div>

          <button
            onClick={() => {
              setIsAuthenticated(false);
              showToast('Você saiu do Portal do Cliente.');
            }}
            className="px-4 py-2.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 font-bold text-xs rounded-lg border border-red-500/30 transition-all flex items-center gap-2 cursor-pointer"
          >
            <LogOut size={15} />
            <span>Sair</span>
          </button>
        </div>
      </div>

      {/* Navigation Sub-Menu Tabs (MÓDULO 18 MANDATORY MENUS) */}
      <div className="flex items-center gap-2 overflow-x-auto pb-2 custom-scrollbar">
        <button
          onClick={() => setActiveTab('licenses')}
          className={`px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
            activeTab === 'licenses'
              ? 'bg-white text-black shadow-sm border border-white/10'
              : 'bg-[#000000] text-gray-400 hover:text-white border border-white/10'
          }`}
        >
          <Key size={15} />
          <span>Minhas Licenças ({licenses.length})</span>
        </button>

        <button
          onClick={() => setActiveTab('buy-license')}
          className={`px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
            activeTab === 'buy-license'
              ? 'bg-white text-black shadow-sm border border-white/10'
              : 'bg-[#000000] text-gray-400 hover:text-white border border-white/10'
          }`}
        >
          <ShoppingCart size={15} />
          <span>Comprar Licença</span>
        </button>

        <button
          onClick={() => setActiveTab('renew-license')}
          className={`px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
            activeTab === 'renew-license'
              ? 'bg-white text-black shadow-sm border border-white/10'
              : 'bg-[#000000] text-gray-400 hover:text-white border border-white/10'
          }`}
        >
          <RefreshCw size={15} />
          <span>Renovar Licença</span>
        </button>

        <button
          onClick={() => setActiveTab('devices')}
          className={`px-4 py-2.5 rounded-lg text-xs font-bold transition-all flex items-center gap-2 shrink-0 cursor-pointer ${
            activeTab === 'devices'
              ? 'bg-white text-black shadow-sm border border-white/10'
              : 'bg-[#000000] text-gray-400 hover:text-white border border-white/10'
          }`}
        >
          <Smartphone size={15} />
          <span>Dispositivos ({devices.length})</span>
        </button>

        <button
          onClick={() => setActiveTab('history')}
