  app.post('/v1/auth/app/login', async (req, res) => {
    try {
      const { licenseCode, username, password, deviceId } = req.body;
      
      let userId: string | null = null;
      if (username && password) {
        const { data: authData, error: authError } = await supabaseAdmin.auth.signInWithPassword({
          email: username.includes('@') ? username : username + '@streamflix.local',
          password
        });
        if (!authError && authData.user) {
          userId = authData.user.id;
        }
      }

      let query = supabaseAdmin.from('licenses').select('*, plan:license_plans(*)').eq('code', licenseCode);
      if (userId) {
        query = query.eq('end_user_id', userId);
      }
      const { data: license, error: licenseError } = await query.single();

      if (licenseError || !license) {
         return res.status(401).json({ success: false, error: 'Licença não encontrada ou código inválido.' });
      }

      if (license.status === 'BLOCKED' || license.status === 'INACTIVE' || license.status === 'SUSPENDED' || license.status === 'CANCELLED') {
         return res.status(403).json({ success: false, error: 'Licença bloqueada ou inativa.' });
      }

      if (license.expires_at && new Date(license.expires_at) < new Date()) {
         return res.status(403).json({ success: false, error: 'Licença expirada.' });
      }
      
      // Device check/registration via license_devices
      const { data: devices } = await supabaseAdmin.from('license_devices').select('*').eq('license_id', license.id);
      const existingDevices = devices || [];
      let currentDevice = existingDevices.find(d => d.device_id === deviceId);
      
      const maxDevs = license.devices_allowed || license.plan?.devices_allowed || 1;

      if (!currentDevice) {
         if (existingDevices.length >= maxDevs) {
             return res.status(403).json({ success: false, error: `Esta licença atingiu o limite de ${maxDevs} dispositivo(s) permitido(s).` });
         }
         const { data: newDev } = await supabaseAdmin.from('license_devices').insert([{
             license_id: license.id,
             device_id: deviceId || `DEV-${Date.now()}`,
             device_name: 'Smart TV App Device',
             platform: 'Android TV',
             first_seen_at: new Date().toISOString(),
             last_seen_at: new Date().toISOString()
         }]).select().single();
         currentDevice = newDev;
      } else {
         await supabaseAdmin.from('license_devices')
           .update({ last_seen_at: new Date().toISOString() })
           .eq('id', currentDevice.id);
      }

      // Fetch servers linked to license or creator servers
      const { data: lServers } = await supabaseAdmin.from('license_servers')
        .select('server_id')
        .eq('license_id', license.id);

      let servers: any[] = [];
      if (lServers && lServers.length > 0) {
        const sIds = lServers.map(ls => ls.server_id);
        const { data: srvs } = await supabaseAdmin.from('iptv_servers').select('*').in('id', sIds).is('deleted_at', null);
        servers = srvs || [];
      }

      if (servers.length === 0 && license.owner_id) {
        const { data: cServers } = await supabaseAdmin.from('iptv_servers').select('*').eq('owner_id', license.owner_id).is('deleted_at', null);
        servers = cServers || [];
      }

      const token = jwt.sign({ id: license.end_user_id || license.id, code: licenseCode }, JWT_SECRET, { expiresIn: '7d' });

      res.json({
        success: true,
        token,
        user: { id: license.end_user_id, username: username || license.code },
        license: {
            code: license.code,
            status: license.status,
            isTrial: license.status === 'TRIAL',
            valid_until: license.expires_at,
            max_devices: maxDevs,
            used_devices: currentDevice ? existingDevices.length : existingDevices.length + 1
        },
        servers: servers || []
      });
    } catch (error: any) {
      res.status(500).json({ success: false, error: error.message });
    }
  });

