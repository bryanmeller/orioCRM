import express from 'express';
import jwt from 'jsonwebtoken';
import path from 'path';
import { createServer as createViteServer } from 'vite';
import { createClient } from '@supabase/supabase-js';
import { lynxRouter } from './server/routes/lynxRoutes.js';
import dotenv from 'dotenv';

dotenv.config();

const JWT_SECRET = process.env.JWT_SECRET || 'streamflix_super_secret_key_123';
const supabaseUrl = process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL || '';
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;
console.log('service role configured:', !!supabaseServiceKey);

const supabaseAdmin = supabaseUrl && supabaseServiceKey ? createClient(supabaseUrl, supabaseServiceKey) : null;

async function startServer() {
  const app = express();
  const PORT = 3000;

  app.use(express.json());
  
  // Lynx API Routes
  app.use('/api/lynx', lynxRouter);

  app.get('/api/health', (req, res) => {
    res.json({ ok: true });
  });

  // Flutter App API: Request Trial
  
  // Shared Auth Middleware using Supabase Auth SDK
  async function requireAdminAuth(req: any, res: any, next: any) {
    try {
      if (!supabaseAdmin) {
        return res.status(500).json({ error: 'Configuração administrativa do Supabase ausente.' });
      }
      const authHeader = req.headers.authorization;
      if (!authHeader) {
        return res.status(401).json({ error: 'Não autorizado (Token ausente)' });
      }

      const token = authHeader.replace('Bearer ', '').trim();
      let authenticatedUser: any = null;

      // 1. Primary validation via Supabase Auth SDK
      const { data: { user }, error: userError } = await supabaseAdmin.auth.getUser(token);
      if (!userError && user) {
        authenticatedUser = user;
      } else {
        // 2. Fallback for custom signed JWTs if applicable
        try {
          const decoded = jwt.verify(token, JWT_SECRET) as any;
          if (decoded && decoded.id) {
            authenticatedUser = { id: decoded.id, email: decoded.email };
          }
        } catch (jwtErr) {
          // Ignore
        }
      }

      if (!authenticatedUser || !authenticatedUser.id) {
        return res.status(401).json({ error: 'Não autorizado (Token inválido ou expirado)' });
      }

      // 3. Fetch user profile
      const { data: profile, error: profileError } = await supabaseAdmin
        .from('profiles')
        .select('*')
        .eq('id', authenticatedUser.id)
        .single();

      if (profileError || !profile) {
        return res.status(403).json({ error: 'Perfil de usuário não encontrado.' });
      }

      if (profile.deleted_at !== null) {
        return res.status(403).json({ error: 'Perfil removido ou desativado.' });
      }

      const st = profile.status;
      if (st === 'BLOCKED' || st === 'INACTIVE' || st === 'Bloqueado' || st === 'Suspenso') {
        return res.status(403).json({ error: 'Perfil inativo ou bloqueado.' });
      }

      req.authUser = authenticatedUser;
      req.authProfile = profile;
      next();
    } catch (err: any) {
      console.error('Error in requireAdminAuth middleware:', err);
      return res.status(401).json({ error: 'Falha no processamento de autenticação.' });
    }
  }

  app.post('/api/admin/create-auth-user', requireAdminAuth, async (req: any, res: any) => {
    try {
      const creatorProfile = req.authProfile;
      const user = req.authUser;

      if (!['SUPER_ADMIN', 'PROVEDOR', 'REVENDA', 'SUBREVENDA', 'PROVIDER', 'RESELLER', 'SUB_RESELLER'].includes(creatorProfile.role)) {
        return res.status(403).json({ error: 'Não autorizado (Role insuficiente)' });
      }

      const { email, password, full_name, role, parent_id, business_mode, username, portal_access, origin, status, plan_id, selected_server_ids, phone, internal_notes, notes, internalNotes } = req.body;
      
      // 1. Data Normalization
      let finalUsername = username;
      if (!finalUsername) {
        finalUsername = email.split('@')[0].toLowerCase().replace(/[^a-z0-9]/g, '') + Math.floor(Math.random() * 10000);
      }

      let officialRole = role;
      if (role === 'PROVEDOR') officialRole = 'PROVIDER';
      if (role === 'REVENDA') officialRole = 'RESELLER';
      if (role === 'SUBREVENDA') officialRole = 'SUB_RESELLER';

      let finalBusinessMode = business_mode;
      if (!finalBusinessMode) {
        if (officialRole === 'PROVIDER') finalBusinessMode = 'PROVIDER';
        else if (officialRole === 'RESELLER') finalBusinessMode = 'RESELLER';
        else if (officialRole === 'SUB_RESELLER') finalBusinessMode = 'SUB_RESELLER';
        else if (officialRole === 'SUPER_ADMIN') finalBusinessMode = 'SYSTEM';
        else finalBusinessMode = 'CUSTOMER';
      }

      const finalParentId = parent_id ? parent_id : null;
      const notesToSave = internal_notes !== undefined ? internal_notes : (notes !== undefined ? notes : (internalNotes !== undefined ? internalNotes : null));
      const safeFullName = full_name || username || (email ? email.split('@')[0] : 'Usuário Final');

      // Status mapping for user_metadata and profiles (profile_status_enum doesn't allow TRIAL)
      let authMetadataStatus = status || 'ACTIVE';
      if (authMetadataStatus === 'TRIAL' || authMetadataStatus === 'Trial') {
        authMetadataStatus = 'ACTIVE';
      }

      // 2. Create Auth User
      const { data: newUser, error: createError } = await supabaseAdmin.auth.admin.createUser({
        email: email,
        password: password || 'ChangeMe123!',
        email_confirm: true,
        user_metadata: {
          full_name: safeFullName,
          role: officialRole,
          username: finalUsername,
          parent_id: finalParentId,
          business_mode: finalBusinessMode,
          portal_access: portal_access || false,
          origin: origin || 'ADMIN_CREATED',
          status: authMetadataStatus,
          phone: phone || ''
        }
      });
      
      if (createError) {
        return res.status(400).json({
          success: false,
          error: {
            code: "AUTH_CREATION_FAILED",
            message: createError.message && createError.message !== '{}' ? createError.message : "Erro ao criar usuário no Auth.",
            details: createError
          }
        });
      }

      const userId = newUser.user.id;

      // Map status for public.profiles (profile_status_enum doesn't contain TRIAL)
      let profileStatus = status || 'ACTIVE';
      if (profileStatus === 'TRIAL' || profileStatus === 'Trial') {
        profileStatus = 'ACTIVE';
      }

      // 3. Upsert public.profiles (handles trigger collisions)
      const profilePayload = {
        id: userId,
        full_name: safeFullName,
        role: officialRole,
        parent_id: finalParentId,
        username: finalUsername,
        email: email,
        status: profileStatus,
        business_mode: finalBusinessMode,
        portal_access: portal_access || false,
        internal_notes: notesToSave
      };

      const { error: insertProfileError } = await supabaseAdmin.from('profiles').upsert(profilePayload);

      if (insertProfileError) {
        console.error('Profile Insert Error:', insertProfileError);
        await supabaseAdmin.auth.admin.deleteUser(userId);
        return res.status(500).json({ 
          success: false,
          error: {
            code: "PROFILE_CREATION_FAILED",
            message: "Erro ao criar perfil do usuário: " + insertProfileError.message,
            details: insertProfileError
          }
        });
      }

      // 4. Fluxo especifico por Role
      let balanceCreated = false;

      if (role === 'RESELLER' || role === 'SUB_RESELLER' || role === 'REVENDA' || role === 'SUBREVENDA') {
        const { error: balanceError } = await supabaseAdmin.from('credit_balances').insert({
          owner_id: userId,
          balance: 0
        });
        if (balanceError) {
          await supabaseAdmin.auth.admin.deleteUser(userId);
          await supabaseAdmin.from('profiles').delete().eq('id', userId);
          return res.status(500).json({ error: 'Erro ao criar saldo da revenda.' });
        }
        balanceCreated = true;
      }

      if ((role === 'PROVIDER' || role === 'PROVEDOR') && plan_id) {
        const { data: plan } = await supabaseAdmin.from('provider_plans').select('*').eq('id', plan_id).single();
        if (plan) {
          const expiresAt = new Date();
          expiresAt.setDate(expiresAt.getDate() + 30);
          const { error: subError } = await supabaseAdmin.from('provider_subscriptions').insert({
            provider_id: userId,
            plan_id: plan.id,
            expires_at: expiresAt.toISOString(),
          });
          if (subError) {
            await supabaseAdmin.auth.admin.deleteUser(userId);
            await supabaseAdmin.from('profiles').delete().eq('id', userId);
            return res.status(500).json({ error: 'Erro ao vincular plano do provedor.' });
          }
        }
      }

      if (role === 'END_USER') {
        // Criar licença
        if (!plan_id) {
           await supabaseAdmin.auth.admin.deleteUser(userId);
           await supabaseAdmin.from('profiles').delete().eq('id', userId);
           return res.status(400).json({
             success: false,
             error: {
               code: "MISSING_PLAN",
               message: "Plano é obrigatório para Usuário Final.",
               details: null
             }
           });
        }
        const { data: plan, error: planError } = await supabaseAdmin.from('license_plans')
            .select('*').eq('id', plan_id).eq('status', 'ACTIVE').is('deleted_at', null).single();
            
        if (planError || !plan) {
           await supabaseAdmin.auth.admin.deleteUser(userId);
           await supabaseAdmin.from('profiles').delete().eq('id', userId);
           return res.status(400).json({
             success: false,
             error: {
               code: "INVALID_PLAN",
               message: "Plano de Licença inválido ou não encontrado.",
               details: planError
             }
           });
        }

        const isTrialMode = (status === 'TRIAL' || status === 'Trial');

        // Debit credits if creator is Reseller and NOT a Trial
        if (!isTrialMode && (creatorProfile.role === 'RESELLER' || creatorProfile.role === 'SUB_RESELLER' || creatorProfile.role === 'REVENDA' || creatorProfile.role === 'SUBREVENDA')) {
            const cost = plan.reseller_credit_cost || plan.credit_cost || 0;
            if (cost > 0) {
                const { data: balanceData } = await supabaseAdmin.from('credit_balances').select('balance').eq('owner_id', user.id).single();
                if (!balanceData || balanceData.balance < cost) {
                    await supabaseAdmin.auth.admin.deleteUser(userId);
                    await supabaseAdmin.from('profiles').delete().eq('id', userId);
                    return res.status(400).json({
                      success: false,
                      error: {
                        code: "INSUFFICIENT_CREDITS",
                        message: "Saldo insuficiente para ativar licença.",
                        details: null
                      }
                    });
                }
                
                await supabaseAdmin.from('credit_transactions').insert([{
                    from_owner_id: user.id,
                    amount: cost,
                    type: 'LICENSE_CREATION',
                    description: `Criação de licença ativa para ${userId}`
                }]);
                
                await supabaseAdmin.from('credit_balances')
                    .update({ balance: balanceData.balance - cost })
                    .eq('owner_id', user.id);
            }
        }

        const expiresAt = new Date();
        let validityDays = 7;
        if (isTrialMode) {
          if (plan.trial_days && plan.trial_days > 0) {
            validityDays = plan.trial_days;
          } else {
            const { data: trialSetting } = await supabaseAdmin
              .from('system_settings')
              .select('setting_value')
              .eq('setting_key', 'trial_days_default')
              .maybeSingle();
            if (trialSetting?.setting_value) {
              validityDays = parseInt(trialSetting.setting_value, 10) || 7;
            }
          }
        } else {
          validityDays = plan.validity_days || 30;
        }
        expiresAt.setDate(expiresAt.getDate() + validityDays);
        
        const code = Math.random().toString(36).substring(2, 8).toUpperCase();
        
        const { error: licError, data: newLicense } = await supabaseAdmin.from('licenses').insert([{
          code,
          owner_id: user.id, // Creator is owner
          end_user_id: userId,
          origin: creatorProfile.role,
          plan_id: plan.id,
          expires_at: expiresAt.toISOString(),
          devices_allowed: isTrialMode ? 1 : (plan.devices_allowed || 1),
          max_servers: plan.max_servers || 1,
          portal_access: portal_access || false,
          status: isTrialMode ? 'TRIAL' : 'ACTIVE'
        }]).select().single();
        
        if (licError) {
           console.error('License Insert Error:', licError);
           await supabaseAdmin.auth.admin.deleteUser(userId);
           await supabaseAdmin.from('profiles').delete().eq('id', userId);
           return res.status(500).json({
             success: false,
             error: {
               code: "TRIAL_CREATION_FAILED",
               message: "Erro ao criar licença do usuário: " + licError.message,
               details: licError
             }
           });
        }

        if (selected_server_ids && selected_server_ids.length > 0) {
          if (creatorProfile.role !== 'SUPER_ADMIN') {
            const { data: validServers } = await supabaseAdmin.from('iptv_servers')
              .select('id')
              .in('id', selected_server_ids)
              .eq('owner_id', user.id);
              
            if (!validServers || validServers.length !== selected_server_ids.length) {
              await supabaseAdmin.auth.admin.deleteUser(userId);
              await supabaseAdmin.from('profiles').delete().eq('id', userId);
              await supabaseAdmin.from('licenses').delete().eq('id', newLicense.id);
              return res.status(400).json({
                success: false,
                error: {
                  code: "INVALID_DNS_SELECTION",
                  message: "Um ou mais Servidores (DNS) selecionados não pertencem à sua conta.",
                  details: null
                }
              });
            }
          }
          
          if (selected_server_ids.length > (plan.max_servers || 1)) {
            await supabaseAdmin.auth.admin.deleteUser(userId);
            await supabaseAdmin.from('profiles').delete().eq('id', userId);
            await supabaseAdmin.from('licenses').delete().eq('id', newLicense.id);
            return res.status(400).json({
              success: false,
              error: {
                code: "DNS_LIMIT_EXCEEDED",
                message: "Quantidade de Servidores (DNS) excede o limite do plano.",
                details: null
              }
            });
          }

          const serverLinks = selected_server_ids.map((dnsId: string) => ({
            license_id: newLicense.id,
            server_id: dnsId
          }));
          await supabaseAdmin.from('license_servers').insert(serverLinks);
        }
      }

      // 5. Query again to confirm
      const { data: finalProfile } = await supabaseAdmin.from('profiles').select('*').eq('id', userId).single();
      
      // Fetch updated profile to get provider_code if it was generated
      const { data: updatedProfile } = await supabaseAdmin.from('profiles').select('provider_code').eq('id', userId).single();
      
      // Fetch license code if created
      let licenseCode = null;
      let licenseId = null;
      if (role === 'END_USER') {
        const { data: licData } = await supabaseAdmin.from('licenses').select('id, code').eq('end_user_id', userId).single();
        if (licData) {
            licenseCode = licData.code;
            licenseId = licData.id;
        }
      }
      
      return res.status(200).json({ 
        success: true, 
        userId: userId, 
        profileCreated: !!finalProfile,
        balanceCreated: balanceCreated,
        providerCode: updatedProfile?.provider_code || null,
        licenseCreated: !!licenseId,
        licenseId: licenseId,
        licenseCode: licenseCode,
        password: password || 'ChangeMe123!',
        username: finalUsername,
        user: newUser.user
      });
      
    } catch (err) {
      console.error(err);
      res.status(500).json({ error: 'Erro interno' });
    }
  });

  // Admin: Convert Trial to Active License
  app.post('/api/admin/convert-trial', requireAdminAuth, async (req: any, res: any) => {
    try {
      const adminProfile = req.authProfile;

      const { licenseId, planId } = req.body;
      if (!licenseId) return res.status(400).json({ error: 'ID da licença é obrigatório' });

      const { data: license, error: licErr } = await supabaseAdmin.from('licenses').select('*').eq('id', licenseId).single();
      if (licErr || !license) return res.status(404).json({ error: 'Licença não encontrada' });

      if (license.status !== 'TRIAL') {
        return res.status(400).json({ error: 'Apenas licenças em estado TRIAL podem ser convertidas.' });
      }

      const targetPlanId = planId || license.plan_id;
      const { data: plan, error: planErr } = await supabaseAdmin.from('license_plans').select('*').eq('id', targetPlanId).single();
      if (planErr || !plan) return res.status(400).json({ error: 'Plano inválido para conversão.' });

      // If reseller/subreseller converts trial, debit credits
      if (adminProfile.role === 'RESELLER' || adminProfile.role === 'SUB_RESELLER' || adminProfile.role === 'REVENDA' || adminProfile.role === 'SUBREVENDA') {
        const cost = plan.reseller_credit_cost || plan.credit_cost || 0;
        if (cost > 0) {
          const { data: balanceData } = await supabaseAdmin.from('credit_balances').select('balance').eq('owner_id', adminProfile.id).single();
          if (!balanceData || balanceData.balance < cost) {
            return res.status(400).json({ error: 'Saldo insuficiente para converter teste em licença ativa.' });
          }

          await supabaseAdmin.from('credit_transactions').insert([{
            from_owner_id: adminProfile.id,
            amount: cost,
            type: 'TRIAL_CONVERSION',
            description: `Conversão de teste para licença ${license.code}`
          }]);

          await supabaseAdmin.from('credit_balances')
            .update({ balance: balanceData.balance - cost })
            .eq('owner_id', adminProfile.id);
        }
      }

      const newExpiresAt = new Date();
      newExpiresAt.setDate(newExpiresAt.getDate() + (plan.validity_days || 30));

      const { data: updatedLicense, error: updateErr } = await supabaseAdmin.from('licenses')
        .update({
          status: 'ACTIVE',
          plan_id: plan.id,
          expires_at: newExpiresAt.toISOString(),
          devices_allowed: plan.devices_allowed || license.devices_allowed,
          max_servers: plan.max_servers || license.max_servers
        })
        .eq('id', licenseId)
        .select()
        .single();

      if (updateErr) throw updateErr;

      res.json({ success: true, message: 'Teste convertido em licença ativa com sucesso!', license: updatedLicense });
    } catch (err: any) {
      res.status(500).json({ error: err.message || 'Erro ao converter teste.' });
    }
  });

  // Admin: Renew License
  app.post('/api/admin/renew-license', requireAdminAuth, async (req: any, res: any) => {
    try {
      const adminProfile = req.authProfile;

      const { licenseId, planId } = req.body;
      if (!licenseId) return res.status(400).json({ error: 'ID da licença é obrigatório' });

      const { data: license, error: licErr } = await supabaseAdmin.from('licenses').select('*').eq('id', licenseId).single();
      if (licErr || !license) return res.status(404).json({ error: 'Licença não encontrada' });

      const targetPlanId = planId || license.plan_id;
      const { data: plan, error: planErr } = await supabaseAdmin.from('license_plans').select('*').eq('id', targetPlanId).single();
      if (planErr || !plan) return res.status(400).json({ error: 'Plano inválido para renovação.' });

      // Debit reseller credits if applicable
      if (adminProfile.role === 'RESELLER' || adminProfile.role === 'SUB_RESELLER' || adminProfile.role === 'REVENDA' || adminProfile.role === 'SUBREVENDA') {
        const cost = plan.reseller_credit_cost || plan.credit_cost || 0;
        if (cost > 0) {
          const { data: balanceData } = await supabaseAdmin.from('credit_balances').select('balance').eq('owner_id', adminProfile.id).single();
          if (!balanceData || balanceData.balance < cost) {
            return res.status(400).json({ error: 'Saldo insuficiente para renovar licença.' });
          }

          await supabaseAdmin.from('credit_transactions').insert([{
            from_owner_id: adminProfile.id,
            amount: cost,
            type: 'LICENSE_RENEWAL',
            description: `Renovação da licença ${license.code}`
          }]);

          await supabaseAdmin.from('credit_balances')
            .update({ balance: balanceData.balance - cost })
            .eq('owner_id', adminProfile.id);
        }
      }

      let baseDate = new Date();
      if (license.expires_at && new Date(license.expires_at) > new Date()) {
        baseDate = new Date(license.expires_at);
      }
      baseDate.setDate(baseDate.getDate() + (plan.validity_days || 30));

      const { data: updatedLicense, error: updateErr } = await supabaseAdmin.from('licenses')
        .update({
          status: 'ACTIVE',
          plan_id: plan.id,
          expires_at: baseDate.toISOString()
        })
        .eq('id', licenseId)
        .select()
        .single();

      if (updateErr) throw updateErr;

      res.json({ success: true, message: `Licença ${license.code} renovada com sucesso!`, license: updatedLicense });
    } catch (err: any) {
      res.status(500).json({ error: err.message || 'Erro ao renovar licença.' });
    }
  });

  // Admin: Reset End User Password
  app.post('/api/admin/reset-user-password', requireAdminAuth, async (req: any, res: any) => {
    try {
      const { userId, newPassword } = req.body;
      if (!userId || !newPassword) return res.status(400).json({ error: 'ID do usuário e nova senha são obrigatórios' });

      if (newPassword.length < 6) {
        return res.status(400).json({ error: 'A nova senha deve ter no mínimo 6 caracteres.' });
      }

      const { error: updateErr } = await supabaseAdmin.auth.admin.updateUserById(userId, {
        password: newPassword
      });

      if (updateErr) throw updateErr;

      res.json({ success: true, message: 'Senha do usuário atualizada com sucesso no Supabase Auth!' });
    } catch (err: any) {
      res.status(500).json({ error: err.message || 'Erro ao redefinir senha do usuário.' });
    }
  });

  // Admin: Get End User DTO for Edit Modal
  app.get(['/api/admin/end-user-dto/:id', '/api/admin/end-user/:id'], requireAdminAuth, async (req: any, res: any) => {
    try {
      const userId = req.params.id;
      if (!userId) return res.status(400).json({ error: 'ID do usuário é obrigatório' });

      // 1. Fetch Profile
      const { data: profile, error: profileErr } = await supabaseAdmin
        .from('profiles')
        .select('*')
        .eq('id', userId)
        .single();

      if (profileErr || !profile) {
        return res.status(404).json({ error: 'Perfil de usuário não encontrado.' });
      }

      // Fetch Auth User for Phone and Metadata
      const { data: authUserData } = await supabaseAdmin.auth.admin.getUserById(userId);
      const authUser = authUserData?.user;
      const userPhone = authUser?.user_metadata?.phone || authUser?.phone || '';

      // Tenant validation check
      if (req.authProfile.role !== 'SUPER_ADMIN' && profile.parent_id !== req.authProfile.id) {
        const { data: licCheck } = await supabaseAdmin
          .from('licenses')
          .select('owner_id')
          .eq('end_user_id', profile.id)
          .eq('owner_id', req.authProfile.id)
          .is('deleted_at', null);

        if (!licCheck || licCheck.length === 0) {
          return res.status(403).json({ error: 'Acesso negado para este usuário final.' });
        }
      }

      // 2. Fetch License with Plan
      const { data: licenses } = await supabaseAdmin
        .from('licenses')
        .select('*, plan:license_plans(*)')
        .eq('end_user_id', userId)
        .is('deleted_at', null)
        .order('created_at', { ascending: false });

      const activeLicense = (licenses && licenses.length > 0) ? licenses[0] : null;

      // 3. Fetch Linked Servers (DNS)
      let selectedServerIds: string[] = [];
      if (activeLicense) {
        const { data: lServers } = await supabaseAdmin
          .from('license_servers')
          .select('server_id')
          .eq('license_id', activeLicense.id);

        if (lServers && lServers.length > 0) {
          selectedServerIds = lServers.map((ls: any) => ls.server_id);
        }
      }

      // Map status
      let mappedStatus = profile.status || 'Ativo';
      if (mappedStatus === 'ACTIVE') mappedStatus = 'Ativo';
      if (mappedStatus === 'INACTIVE' || mappedStatus === 'BLOCKED') mappedStatus = 'Bloqueado';
      if (mappedStatus === 'SUSPENDED') mappedStatus = 'Suspenso';

      // 4. Build single unified DTO conforming to required spec
      const dto = {
        // PROFILE
        id: profile.id,
        full_name: profile.full_name || '',
        name: profile.full_name || '',
        username: profile.username || '',
        phone: userPhone,
        email: profile.email || authUser?.email || '',
        status: mappedStatus,
        portal_access: profile.portal_access ?? activeLicense?.portal_access ?? false,
        internal_notes: profile.internal_notes || profile.notes || '',
        notes: profile.internal_notes || profile.notes || '',
        parent_id: profile.parent_id || null,
